# DRYOS Delivery — exemplo de .env.local
# Copie para `.env.local` e preencha com valores reais.
# .env.local NÃO é commitado (ver .gitignore).
#
# Projeto Supabase: "Delivery OS" (ref tmsaucxoeqpfluzwrwkc) na org Altis Lisboa.
# Dashboard: https://supabase.com/dashboard/project/tmsaucxoeqpfluzwrwkc

# URL pública do projeto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tmsaucxoeqpfluzwrwkc.supabase.co

# Chave publicável (formato `sb_publishable_...`) — usada no browser, segura de expor.
# Dashboard → Settings → API → "Publishable" key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Chave service role — SERVER ONLY, NUNCA expor no cliente.
# Preferido (Vercel / docs atuais):
# Dashboard → Settings → API → "service_role" secret.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxx
#
# Nome legado ainda aceito pelo código se SUPABASE_SERVICE_ROLE_KEY não existir.
SUPABASE_SECRET_KEY=eyJxxxxxx

# Base URL pública do app (usada em links públicos, redirects de auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret pra autenticar a rota /api/cron/notifications. Vercel Cron envia
# Authorization: Bearer ${CRON_SECRET} automaticamente quando setado no
# projeto. Gerar com: openssl rand -hex 32
CRON_SECRET=

# Webhook HTTPS global (n8n) para notificações quando a Operação não tem
# `notification_webhook_url` e para o resumo diário (`daily_digest`) no cron.
# Mesmas regras de segurança que o campo por Operação (só https, host público).
NOTIFICATION_WEBHOOK_URL=
