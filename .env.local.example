# DRYOS Delivery — exemplo de .env.local
# Copie para `.env.local` e preencha com valores reais.
# .env.local NÃO é commitado (ver .gitignore).

# URL do projeto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (anon) — usada no browser, segura de expor
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave secreta (service_role) — SERVER ONLY, NUNCA expor no cliente
# Usada em scripts admin, route handlers privilegiados, migrations seedadas
SUPABASE_SECRET_KEY=

# Base URL pública do app (usada em links públicos, redirects de auth)
NEXT_PUBLIC_APP_URL=http://localhost:3000
